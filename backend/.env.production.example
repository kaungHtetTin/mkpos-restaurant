APP_NAME="Little Lemon POS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://restaurant.mkposmyanmar.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant
DB_USERNAME=restaurant
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_LEVEL=warning

REALTIME_ENABLED=true
REALTIME_HOST=127.0.0.1
REALTIME_PORT=8081
REALTIME_PUBLISH_URL=https://restaurant-socket.mkposmyanmar.com/publish
REALTIME_PUBLIC_URL=wss://restaurant-socket.mkposmyanmar.com/socket
REALTIME_ORIGINS=https://restaurant.mkposmyanmar.com
# Set the same long random value on the Laravel and socket servers.
REALTIME_SECRET=

OFFICE_ADMIN_NAME="Office Admin"
OFFICE_ADMIN_EMAIL=
OFFICE_ADMIN_PASSWORD=
