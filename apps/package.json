{
  "name": "little-lemon-pos-apps",
  "version": "1.0.5",
  "private": true,
  "description": "Android and Windows clients for MKPOS restaurant",
  "author": "MKPOS",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "windows:x64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Arch x64",
    "windows:ia32": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Arch ia32",
    "windows:build": "npm run windows:x64 && npm run windows:ia32"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.littlelemon.pos",
    "productName": "MKPOS restaurant",
    "asar": true,
    "directories": {
      "output": "../artifacts/windows/1.0.5"
    },
    "files": [
      "electron/**/*",
      "shell/index.html",
      "shell/setup.css",
      "shell/icon.png",
      "production.json",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signExecutable": false,
      "icon": "branding/app.ico",
      "artifactName": "MKPOS-restaurant-${version}-windows-${arch}-portable.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "asarUnpack": [
      "electron/serial-print.ps1"
    ]
  }
}
