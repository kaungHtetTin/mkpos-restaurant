NODE_ENV=production
APP_ENV=production
APP_URL=https://restaurant.mkposmyanmar.com
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8081
REALTIME_ORIGINS=https://restaurant.mkposmyanmar.com
# Required: use exactly the same secret as the Laravel app's REALTIME_SECRET.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REALTIME_SECRET=
# Hosting platforms can set PORT; it takes precedence over REALTIME_PORT.
# PORT=8081
